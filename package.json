{
  "name": "near-bail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "deploy": "vinxi build && wrangler deploy",
    "deploy:pages": "wrangler pages deploy pages --project-name near-bail --branch demo --commit-dirty=true",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test app/lib/near.test.ts app/lib/guardrail.test.ts",
    "verify:contract": "node scripts/verify-contract.mjs",
    "contract:build": "cd contract && cargo near build non-reproducible-wasm",
    "contract:test": "cd contract && cargo test"
  },
  "dependencies": {
    "@tanstack/react-router": "1.114.3",
    "@tanstack/react-start": "1.114.3",
    "framer-motion": "^11.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reicon-react": "^1.2.6",
    "vinxi": "^0.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^3.109.2"
  },
  "overrides": {
    "@tanstack/react-router": "1.114.3",
    "@tanstack/router-core": "1.114.3",
    "@tanstack/router-generator": "1.114.3",
    "@tanstack/router-plugin": "1.114.3",
    "@tanstack/react-start": "1.114.3",
    "@tanstack/react-start-client": "1.114.3",
    "@tanstack/react-start-config": "1.114.3",
    "@tanstack/react-start-server": "1.114.3",
    "@tanstack/react-start-plugin": "1.114.3",
    "@tanstack/react-start-router-manifest": "1.114.3",
    "@tanstack/react-start-server-functions-client": "1.114.3",
    "@tanstack/start-server-functions-server": "1.114.3",
    "@tanstack/react-start-server-functions-handler": "1.114.3",
    "@tanstack/react-start-server-functions-ssr": "1.114.3",
    "@tanstack/react-start-server-functions-fetcher": "1.114.3",
    "@tanstack/react-start-api-routes": "1.114.3",
    "@tanstack/server-functions-plugin": "1.114.3",
    "@tanstack/directive-functions-plugin": "1.114.3",
    "@tanstack/router-utils": "1.114.3",
    "@tanstack/start-fn-stubs": "1.114.3",
    "@tanstack/start-storage-context": "1.114.3",
    "@tanstack/virtual-file-routes": "1.114.3"
  }
}
